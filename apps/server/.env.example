DATABASE_URL=postgres://paroliere:paroliere@localhost:5432/paroliere
# Almeno 32 caratteri casuali (es. `openssl rand -base64 48`). Firma il cookie di sessione.
SESSION_SECRET=cambia-questo-valore-con-almeno-32-caratteri
PORT=3000
# Portale whoru: da lì arriva l'identità (token firmato). In locale, se non c'è il portale, usa DEV_LOGIN.
PORTAL_URL=https://slothymic.com
SERVICE_ID=paroliere
# Solo sviluppo: abilita http://localhost:5173/api/auth/dev?user=mario&admin=1
DEV_LOGIN=true
# Token con cui il gioco chiama le API amici del portale (stesso valore di SERVICE_TOKEN_PAROLIERE sul portale, almeno 32 caratteri).
# In sviluppo con DEV_LOGIN lo si può omettere: gli utenti dev-* sono tutti amici tra loro.
# PORTAL_SERVICE_TOKEN=
