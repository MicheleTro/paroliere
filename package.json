{
  "name": "paroliere",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "build:dict": "pnpm --filter @paroliere/dict-builder run build:dict",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "cli": "pnpm --filter @paroliere/cli run cli",
    "dev": "pnpm --filter @paroliere/web run dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier": "^3.4.2",
    "svelte-eslint-parser": "^1.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
